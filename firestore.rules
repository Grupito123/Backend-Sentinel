rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Rutas de los perfiles segun el modelo.
    function rutaUsuarios(uid) { return /databases/$(database)/documents/usuarios/$(uid); }
    function rutaAlumno(uid) { return /databases/$(database)/documents/alumnos/$(uid); }
    function rutaPadre(uid) { return /databases/$(database)/documents/padres/$(uid); }

    function existeUsuarios() { return autenticado() && exists(rutaUsuarios(request.auth.uid)); }
    function existeAlumno() { return autenticado() && exists(rutaAlumno(request.auth.uid)); }
    function existePadre() { return autenticado() && exists(rutaPadre(request.auth.uid)); }

    // Documento `usuarios/{uid}` de una cuenta staff o antigua.
    // OJO: `get()` sobre un documento inexistente ABORTA la regla, por eso quien
    // lo use debe comprobar antes `existeUsuarios()`.
    function perfil() {
      return get(rutaUsuarios(request.auth.uid));
    }

    /**
     * Rol de la cuenta, resuelto por la coleccion donde vive su perfil.
     *
     * `usuarios` gana SIEMPRE: el personal y las cuentas anteriores al registro
     * por coleccion siguen usando su rol ALMACENADO, sin cambios.
     *
     * Solo si no existe documento en `usuarios` se deduce el rol de la coleccion
     * del perfil publico (Opcion B):
     *   `alumnos/{uid}` -> 'alumno'
     *   `padres/{uid}`  -> 'padre'
     *
     * Ninguna rama guarda el rol: se deduce de la coleccion, asi que el rol y el
     * perfil no pueden quedar desincronizados. Cada rama exige `activo == true`,
     * igual que antes: una cuenta desactivada pierde todos sus permisos.
     */
    function rolDeUsuarios() {
      let d = get(rutaUsuarios(request.auth.uid)).data;
      return d.activo == true ? d.rol : 'ninguno';
    }

    function rolDeAlumno() {
      let d = get(rutaAlumno(request.auth.uid)).data;
      return d.activo == true ? 'alumno' : 'ninguno';
    }

    function rolDePadre() {
      let d = get(rutaPadre(request.auth.uid)).data;
      return d.activo == true ? 'padre' : 'ninguno';
    }

    function rol() {
      return !autenticado() ? 'ninguno'
        : existeUsuarios() ? rolDeUsuarios()
        : existeAlumno() ? rolDeAlumno()
        : existePadre() ? rolDePadre()
        : 'ninguno';
    }

    function esAdmin() { return rol() == 'administrador'; }
    function esDirectivo() { return rol() == 'directivo'; }
    function esPreceptor() { return rol() == 'preceptor'; }
    function esProfesor() { return rol() == 'profesor'; }
    function esAlumno() { return rol() == 'alumno'; }
    function esPadre() { return rol() == 'padre'; }
    function esDocente() { return esPreceptor() || esProfesor(); }
    function esGestion() { return esAdmin() || esDirectivo(); }
    function esStaff() { return esGestion() || esDocente(); }

    /**
     * El perfil del alumno del registro publico vive en `alumnos/{uid}`: el ID del
     * documento ES el uid, y su `usuarioId` se apunta a si mismo.
     *
     * El perfil anterior vive en `usuarios/{uid}` y su ficha en otro documento de
     * `alumnos`, referenciado por `usuarios.alumnoId`. Las dos ramas conviven para
     * que las cuentas ya creadas sigan funcionando sin migracion.
     */
    function esPerfilAlumnoPublico() {
      return autenticado() && !existeUsuarios() && existeAlumno();
    }

    /**
     * ID de la ficha de alumno del usuario actual, segun el modelo que use.
     *
     * `.get('alumnoId', null)` y el `existeUsuarios()` explicito hacen que este
     * helper sea SEGURO POR SI MISMO, no por disciplina del llamador: si la
     * cuenta no es alumno (por ejemplo, un padre), devuelve null en vez de
     * intentar leer un `usuarios/{uid}` inexistente, lo que abortaria la regla.
     */
    function miAlumnoId() {
      return esPerfilAlumnoPublico() ? request.auth.uid
        : existeUsuarios() ? perfil().data.get('alumnoId', null)
        : null;
    }

    /** Ficha de alumno del usuario actual; null si no tiene. */
    function miAlumno() {
      let id = miAlumnoId();
      return id == null ? null : get(rutaAlumno(id));
    }

    function esMiAlumno(alumnoId) {
      return alumnoId != null && esAlumno() && alumnoId == miAlumnoId();
    }

    // Vinculo padre <-> hijo.
    //
    // El alta publica pide el DNI del hijo, pero las reglas NO pueden resolver
    // DNI -> alumnoId: no existe `where()` en rules, y el ID del documento de
    // `alumnos` nunca es el DNI (el seed usa `alu_<legajo>` y la app movil usa
    // `addDoc`, que genera un ID aleatorio). Sin un path exacto, `get()` no puede
    // derivarlo.
    //
    // Por eso la vinculacion real la resuelve la ADMINISTRACION, que escribe
    // `hijoAlumnoId` con el alumnoId ya determinado. Ni el padre ni el alumno
    // pueden escribirlo: quedan fuera del allowlist de su auto-update, y el alta
    // publica lo exige en null.
    //
    // `.get(clave, null)` se usa porque leer una clave ausente de un `get()` aborta
    // la regla; con el valor por defecto la comparacion simplemente da false.
    function miHijoAlumnoId() {
      // El padre del registro publico no tiene documento en `usuarios`: su vinculo
      // vive en `padres/{uid}`. La rama de `usuarios` cubre los padres antiguos.
      return !esPadre() ? null
        : existeUsuarios() ? perfil().data.get('hijoAlumnoId', null)
        : get(rutaPadre(request.auth.uid)).data.get('hijoAlumnoId', null);
    }

    function esMiHijo(alumnoId) {
      return esPadre() && alumnoId != null && alumnoId == miHijoAlumnoId();
    }

    function esAlumnoDeCurso(cursoId) {
      return esAlumno() && cursoId != null && miAlumno().data.cursoId == cursoId;
    }

    function datosCurso(cursoId) {
      return get(/databases/$(database)/documents/cursos/$(cursoId)).data;
    }

    function datosMateria(materiaId) {
      return get(/databases/$(database)/documents/materias/$(materiaId)).data;
    }

    function datosAlumno(alumnoId) {
      return get(/databases/$(database)/documents/alumnos/$(alumnoId)).data;
    }

    function datosHorario(horarioId) {
      return get(/databases/$(database)/documents/horarios/$(horarioId)).data;
    }

    function datosSesion(sesionId) {
      return get(/databases/$(database)/documents/sesionesQR/$(sesionId)).data;
    }

    function esPreceptorDelCurso(cursoId) {
      return esPreceptor() && request.auth.uid in datosCurso(cursoId).preceptorIds;
    }

    function esDocenteDelCurso(cursoId) {
      return esProfesor() && request.auth.uid in datosCurso(cursoId).docenteIds;
    }

    function esDocenteDeMateria(materiaId) {
      return esProfesor() && materiaId != null && datosMateria(materiaId).docenteId == request.auth.uid;
    }

    function esMateriaDelCurso(materiaId, cursoId) {
      return esDocenteDeMateria(materiaId) && datosMateria(materiaId).cursoId == cursoId;
    }

    function esAlumnoDeLaMateria(materiaId) {
      return esAlumno() && datosMateria(materiaId).cursoId == miAlumno().data.cursoId;
    }

    function puedeVerCurso(cursoId) {
      return esStaff() || esAlumnoDeCurso(cursoId);
    }

    function puedeOperarCurso(cursoId) {
      return esGestion() || esPreceptorDelCurso(cursoId) || esDocenteDelCurso(cursoId);
    }

    function puedeOperarMateria(materiaId) {
      return esGestion() || esDocenteDeMateria(materiaId);
    }

    function camposAsistencia() {
      return ['estado', 'observaciones', 'actualizadoEn'];
    }

    // Esquema real que escribe attendance.js al crear una asistencia por QR.
    function camposAsistenciaCreacion() {
      return ['alumnoId', 'cursoId', 'materiaId', 'horarioId', 'fecha', 'fechaKey', 'hora',
              'estado', 'observaciones', 'registradoPor', 'metodoRegistro', 'sesionQRId',
              'actualizadoEn', 'creadoEn'];
    }

    // Unico allowlist de un reescaneo del alumno: NO incluye creadoEn, identidad,
    // curso/materia/horario, fecha, metodoRegistro ni sesionQRId (inmutables).
    function camposAsistenciaQrUpdate() {
      return ['hora', 'estado', 'actualizadoEn'];
    }

    // Campos permitidos en un perfil de usuario. Deben coincidir con el documento
    // que escribe App-Sentinela (src/services/firestore/users.js) y con el alta
    // publica de la web.
    //
    // `hijoAlumnoId` es el vinculo padre -> alumno. OJO: al estar en esta lista
    // queda permitido por el `hasOnly` del alta publica, asi que la rama de
    // auto-registro lo bloquea explicitamente con == null (ver mas abajo). Si se
    // sacarera de esta lista, el admin no podria escribirlo al vincular.
    function camposPerfil() {
      return ['uid', 'nombre', 'apellido', 'email', 'dni', 'rol', 'telefono',
              'activo', 'alumnoId', 'dniVinculado', 'hijoAlumnoId',
              'fechaCreacion', 'updatedAt'];
    }

    // Unico allowlist de UPDATE de una sesion QR (DECISIONES 1 y 3).
    // Se puede tocar SOLO: codigo (rotacion), activo, horaFin, cerradoEn y
    // actualizadoEn. Quedan inmutables: cursoId, materiaId, creadoPor, fecha,
    // fechaKey, horaInicio y ubicacion.
    function camposSesionQrUpdate() {
      return ['codigo', 'activo', 'horaFin', 'cerradoEn', 'actualizadoEn'];
    }

    // En las ramas de auto-registro la condicion propia va PRIMERA a proposito:
    // esAdmin() hace get() sobre el perfil del solicitante, que todavia no existe
    // durante el alta. Si se evaluara primero, el error de get() denies el request.
    match /usuarios/{usuarioId} {
      allow read: if (autenticado() && request.auth.uid == usuarioId) || esAdmin();

      // Alta publica: el usuario elige su rol, pero SOLO entre los tres roles
      // publicos del formulario (alumno, padre, profesor/docente). Los roles
      // preceptor, directivo y administrador NO se pueden auto-asignar: los crea
      // un admin. Cualquier otro valor de `rol` hace fallar la condicion.
      //
      // Esto es la frontera de la clasificacion de cuentas: `rol` es la
      // identidad y NO se deriva de nada. Un rol desconocido no coincide con
      // ningun es*() y deja la cuenta sin permisos (fallo cerrado).
      //
      // La web (registro por coleccion) NO usa esta rama: el alumno va a
      // `alumnos/{uid}` y el padre a `padres/{uid}`. Queda para la app movil y
      // para altas administrativas. Por eso exige que NO exista ya un perfil en
      // esas colecciones: sin ese chequeo, un alumno o un padre podria crear
      // despues un `usuarios/{uid}` con `rol: 'profesor'` y escalarse solo.
      //
      // DISEÑO A: el alta NUNCA vincula. alumnoId, dniVinculado y hijoAlumnoId
      // tienen que venir null o ausentes; si vinieran informedos, la cuenta se
      // adjudicaria sola una ficha (y con ella acceso a ese alumno entero). La
      // vinculacion real la hace el administrador despues.
      allow create: if (autenticado()
                        && request.auth.uid == usuarioId
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.rol in ['alumno', 'padre', 'profesor']
                        && request.resource.data.activo == true
                        && !existeAlumno()
                        && !existePadre()
                        && (!('alumnoId' in request.resource.data)
                            || request.resource.data.alumnoId == null)
                        && (!('dniVinculado' in request.resource.data)
                            || request.resource.data.dniVinculado == null)
                        && (!('hijoAlumnoId' in request.resource.data)
                            || request.resource.data.hijoAlumnoId == null)
                        && request.resource.data.keys().hasOnly(camposPerfil()))
                    || esAdmin();

      allow delete: if esAdmin();

      // Auto-update del propio perfil: SOLO datos de contacto y nombre.
      //
      // DISEÑO A: no existe ninguna rama de auto-reclamacion (self-claim). El
      // alumno no puede escribir alumnoId, dniVinculado, rol, activo, dni ni
      // ningun campo administrativo, porque quedan todos fuera del allowlist.
      // Tampoco puede tocar alumnos/{alumnoId}.usuarioId: esa coleccion exige
      // esAdmin() para modificar ese campo (ver match /alumnos).
      allow update: if (autenticado()
                        && request.auth.uid == usuarioId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['telefono', 'nombre', 'apellido', 'updatedAt']))
                    || esAdmin();
    }

    match /alumnos/{alumnoId} {
      // `get` = lectura puntual. La rama `resource == null` cubre el documento
      // INEXISTENTE: sin ella, evaluar `resource.data.cursoId` sobre un null
      // aborta la regla y el SDK responde `permission-denied` en lugar de
      // `exists() == false`. Caso real: resolverPerfil() hace getDoc de
      // `alumnos/{uid}` con el uid de un PADRE (que no tiene ficha) y la
      // resolucion del perfil se rompe. `resource == null` solo confirma la
      // ausencia: no expone datos de ningun alumno.
      allow get: if (autenticado() && resource == null)
        || esGestion()
        || esPreceptorDelCurso(resource.data.cursoId)
        || esDocenteDelCurso(resource.data.cursoId)
        || esMiAlumno(alumnoId);

      // `list` = consultas. Se conservan EXACTAMENTE las condiciones previas.
      // En una lista no existe la variable `resource`; solo la rama de gestion
      // (que cortocircuita antes de tocarla) resulta efectiva, y el resto
      // deniega igual que antes.
      allow list: if esGestion()
        || esPreceptorDelCurso(resource.data.cursoId)
        || esDocenteDelCurso(resource.data.cursoId)
        || esMiAlumno(alumnoId);
      // Alta publica (Opcion B): el alumno crea su propia ficha en `alumnos/{uid}`,
      // con `usuarioId == uid`, `cursoId == null`, `legajo == ""` y solo campos
      // minimos permitidos. No puede elegir curso, legajo ni usuarioId distinto.
      // Admin/directivo mantienen sus permisos para crear/vincular fichas.
      allow create: if (autenticado()
                        && request.auth.uid == alumnoId
                        && request.resource.data.usuarioId == request.auth.uid
                        && request.resource.data.cursoId == null
                        && request.resource.data.legajo == ""
                        && request.resource.data.activo == true
                        && request.resource.data.keys().hasOnly(['nombre', 'apellido', 'dni', 'legajo', 'email', 'telefono', 'cursoId', 'activo', 'usuarioId', 'creadoEn', 'actualizadoEn']))
                    || esAdmin()
                    || (esDirectivo()
                        && (!('usuarioId' in request.resource.data)
                            || request.resource.data.usuarioId == null));
      allow delete: if esAdmin();
      // El propio alumno solo puede editar sus datos de contacto. cursoId,
      // activo, legajo, usuarioId y cualquier campo administrativo quedan
      // fuera del allowlist (los gestiona admin/directivo).
      allow update: if esAdmin()
        || (esDirectivo()
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['usuarioId']))
        || (esMiAlumno(alumnoId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['usuarioId'])
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nombre', 'apellido', 'telefono', 'email', 'actualizadoEn']));
    }

    match /padres/{padreId} {
      // El padre/madre lee SOLO su propio documento. La institucion (admin y
      // directivo) puede consultar todos para resolver la vinculacion con el hijo.
      allow read: if (autenticado() && request.auth.uid == padreId)
        || esAdmin()
        || esDirectivo();

      // Alta publica (Opcion B): el padre crea su propio perfil en `padres/{uid}`.
      // `hijoAlumnoId` debe venir null: el padre NO se autoasigna un hijo. La
      // vinculacion la resuelve la administracion (o el directivo), que si puede
      // modificar ese campo en el `update` de mas abajo.
      // `dniHijo` es solo el dato inicial que pidio el formulario: no habilita
      // ningun permiso por si solo (los permisos salen de `hijoAlumnoId`).
      allow create: if (autenticado()
                        && request.auth.uid == padreId
                        && request.resource.data.usuarioId == request.auth.uid
                        && request.resource.data.activo == true
                        && request.resource.data.hijoAlumnoId == null
                        && request.resource.data.nombre is string
                        && request.resource.data.apellido is string
                        && request.resource.data.email is string
                        && request.resource.data.dniHijo is string
                        && request.resource.data.keys().hasOnly(['usuarioId', 'nombre', 'apellido', 'email', 'dni', 'telefono', 'dniHijo', 'hijoAlumnoId', 'activo', 'fechaCreacion', 'updatedAt']))
                    || esAdmin();

      // El padre solo modifica sus datos personales. NO puede tocar `usuarioId`,
      // `hijoAlumnoId`, `activo` ni `padreId`: quedan fuera del allowlist.
      // La institucion si puede resolver la vinculacion.
      allow update: if esAdmin()
        || esDirectivo()
        || (autenticado()
            && request.auth.uid == padreId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nombre', 'apellido', 'telefono', 'dni', 'dniHijo', 'updatedAt']));

      allow delete: if esAdmin();
    }

    match /cursos/{cursoId} {
      allow read: if puedeVerCurso(cursoId);
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || esDirectivo();
    }

    match /materias/{materiaId} {
      allow read: if esStaff() || esAlumnoDeCurso(resource.data.cursoId);
      allow create, delete: if esAdmin() || esDirectivo();
      allow update: if esAdmin()
        || esDirectivo()
        || (esDocenteDeMateria(materiaId)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nombre', 'descripcion', 'activo', 'updatedAt']));
    }

    match /inscripciones/{inscripcionId} {
      allow read: if esStaff() || esMiAlumno(resource.data.alumnoId);
      allow create, delete: if esAdmin();
      allow update: if esAdmin();
    }

    match /horarios/{horarioId} {
      allow read: if puedeVerCurso(resource.data.cursoId);
      allow create, delete: if esAdmin() || esDirectivo();
      allow update: if esAdmin()
        || esDirectivo()
        || (esPreceptorDelCurso(resource.data.cursoId)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['aula', 'horaInicio', 'horaFin', 'activo', 'updatedAt']));
    }

    match /asistencias/{asistenciaId} {
      // El padre lee SOLO las asistencias de su hijo vinculado (hijoAlumnoId, que
      // solo escribe el admin). No accede a la ficha, ni a otros alumnos, ni a
      // notas/boletines/examenes: "solo asistencia" en sentido estricto.
      allow read: if esMiAlumno(resource.data.alumnoId)
        || esMiHijo(resource.data.alumnoId)
        || puedeOperarCurso(resource.data.cursoId);

      // CREATE (staff): registra asistencia en un curso que puede operar.
      // CREATE (alumno): solo auto-registro por QR, en su propio curso, con
      // registradoPor = su propio uid, allowlist exacta y validacion server-side
      // de materia/horario/sesion (existencia, curso y ventana horaria). El
      // creadoEn lo resuelve el serverTimestamp del SDK (no se confia en el cliente).
      //
      // PRUEBA VERIFICABLE: el QR stateless (qrCore/qrDinamico) lleva un secreto
      // embebido en el bundle, asi que Firestore NO puede demostrar que el token
      // lo emitio una autoridad confiable. Por eso el CREATE del alumno EXIGE
      // siempre una sesionQRId (nunca null) que exista en sesionesQR, sea del
      // mismo curso y fechaKey, este activa y caiga dentro de su ventana
      // [horaInicio, horaFin] segun el reloj del servidor (request.time). El token
      // stateless queda, a lo sumo, como validacion de cliente.
      allow create: if puedeOperarCurso(request.resource.data.cursoId)
        || (esMiAlumno(request.resource.data.alumnoId)
            && request.resource.data.alumnoId == miAlumnoId()
            && miAlumno() != null
            && request.resource.data.cursoId == miAlumno().data.cursoId
            && request.resource.data.metodoRegistro == 'qr'
            && request.resource.data.estado in ['presente', 'tarde']
            && request.resource.data.registradoPor == request.auth.uid
            && request.resource.data.keys().hasOnly(camposAsistenciaCreacion())
            && (request.resource.data.materiaId == null
                || datosMateria(request.resource.data.materiaId).cursoId == request.resource.data.cursoId)
            && (request.resource.data.horarioId == null
                || datosHorario(request.resource.data.horarioId).cursoId == request.resource.data.cursoId)
            && request.resource.data.sesionQRId is string
            && datosSesion(request.resource.data.sesionQRId).activo == true
            && request.time >= datosSesion(request.resource.data.sesionQRId).horaInicio
            && request.time <= datosSesion(request.resource.data.sesionQRId).horaFin
            && datosSesion(request.resource.data.sesionQRId).cursoId == request.resource.data.cursoId
            && datosSesion(request.resource.data.sesionQRId).fechaKey == request.resource.data.fechaKey);

      // UPDATE (staff): estado/observaciones, sin poder tocar creadoEn.
      // UPDATE (alumno, reescaneo): solo hora/estado/actualizadoEn; hora no
      // retrocede ni queda en el futuro, y tarde -> presente queda bloqueado.
      // Todos los campos de identidad, curso, materia, fecha, metodo y sesion
      // quedan inmutables (fuera del allowlist / con guard de creadoEn).
      allow update: if (
                        (esGestion()
                         || ((esPreceptorDelCurso(resource.data.cursoId) || esDocenteDelCurso(resource.data.cursoId))
                             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposAsistencia())))
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creadoEn'])
                      )
        || (esMiAlumno(resource.data.alumnoId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposAsistenciaQrUpdate())
            && request.resource.data.hora >= resource.data.hora
            && request.resource.data.hora <= request.time
            && !(resource.data.estado == 'tarde' && request.resource.data.estado == 'presente'));
      allow delete: if esAdmin();
    }

    match /sesionesQR/{sesionId} {
      // LIMITACION CONOCIDA (sin Cloud Functions en esta etapa): un alumno
      // autorizado (puedeVerCurso) puede leer el codigo de una sesion de su
      // curso. Mitigacion pendiente: mover la validacion/entrega a una Function.
      allow read: if puedeVerCurso(resource.data.cursoId);
      // CREATE (DECISION 2): pueden abrir sesion administrador, directivo,
      // preceptor del curso y profesor del curso. `puedeOperarCurso` ya es
      // esGestion() (administrador + directivo) OR preceptor/docente del curso,
      // asi que un alumno nunca puede crear una sesion.
      allow create: if puedeOperarCurso(request.resource.data.cursoId)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() == 8
        && request.resource.data.keys().hasOnly(['cursoId', 'materiaId', 'creadoPor', 'fecha',
              'fechaKey', 'horaInicio', 'horaFin', 'codigo', 'activo', 'ubicacion', 'creadoEn']);

      // UPDATE (DECISIONES 1 y 3): el administrador conserva sus permisos.
      // Directivo, preceptor y profesor comparten el MISMO allowlist acotado
      // (camposSesionQrUpdate), que incluye `codigo` para la rotacion.
      // El curso evaluado es resource.data.cursoId (el vigente), de modo que
      // una sesion abierta no se puede mover a otro curso.
      allow update: if esAdmin()
        || ((esDirectivo()
             || esPreceptorDelCurso(resource.data.cursoId)
             || esDocenteDelCurso(resource.data.cursoId))
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(camposSesionQrUpdate()));
      allow delete: if esAdmin();
    }

    match /justificaciones/{justificacionId} {
      allow read: if esStaff() || esMiAlumno(resource.data.alumnoId);
      allow create: if esMiAlumno(request.resource.data.alumnoId)
        || esGestion()
        || esPreceptorDelCurso(datosAlumno(request.resource.data.alumnoId).cursoId);
      allow update: if esGestion()
        || esPreceptorDelCurso(datosAlumno(resource.data.alumnoId).cursoId)
        || (esMiAlumno(resource.data.alumnoId)
            && resource.data.estado == 'pendiente'
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['motivo', 'observaciones', 'actualizadoEn']));
      allow delete: if esAdmin();
    }

    match /notas/{notaId} {
      allow read: if esMiAlumno(resource.data.alumnoId) || esStaff();
      allow create: if esProfesor() && esMateriaDelCurso(request.resource.data.materiaId, request.resource.data.cursoId);
      // El profesor solo edita los campos calificables: alumnoId/materiaId/cursoId
      // quedan inmutables (no puede mover una nota de alumno, materia o curso).
      allow update: if esProfesor()
        && esMateriaDelCurso(resource.data.materiaId, resource.data.cursoId)
        && request.resource.data.materiaId == resource.data.materiaId
        && request.resource.data.cursoId == resource.data.cursoId
        && request.resource.data.alumnoId == resource.data.alumnoId
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nota', 'tipo', 'descripcion', 'periodo', 'fecha', 'observaciones', 'actualizadoEn']);
      allow delete: if esProfesor() && esMateriaDelCurso(resource.data.materiaId, resource.data.cursoId);
    }

    match /examenes/{examenId} {
      allow read: if puedeVerCurso(resource.data.cursoId);
      allow create: if esGestion() || esProfesor() && esMateriaDelCurso(request.resource.data.materiaId, request.resource.data.cursoId);
      allow update, delete: if esGestion() || esDocenteDeMateria(resource.data.materiaId);
    }

    match /trabajosPracticos/{tpId} {
      allow read: if puedeVerCurso(resource.data.cursoId);
      allow create: if esGestion() || esProfesor() && esMateriaDelCurso(request.resource.data.materiaId, request.resource.data.cursoId);
      allow update, delete: if esGestion() || esDocenteDeMateria(resource.data.materiaId);
    }

    match /entregasTP/{entregaId} {
      allow read: if esMiAlumno(resource.data.alumnoId) || esStaff();
      allow create: if esMiAlumno(request.resource.data.alumnoId);
      allow update: if esMiAlumno(resource.data.alumnoId)
        || (esProfesor() && esDocenteDeMateria(get(/databases/$(database)/documents/trabajosPracticos/$(resource.data.tpId)).data.materiaId));
      allow delete: if esAdmin();
    }

    match /novedades/{novedadId} {
      allow read: if esStaff() || esAlumno();
      allow create: if esStaff();
      allow update: if esStaff()
        || (esAlumno()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['confirmadaPor', 'leidaPor']));
      allow delete: if esAdmin() || esDirectivo();
    }

    match /notificaciones/{notificacionId} {
      allow read: if autenticado() && resource.data.usuarioId == request.auth.uid;
      allow update: if autenticado() && resource.data.usuarioId == request.auth.uid;
      allow create: if esStaff();
      allow delete: if esAdmin();
    }

    match /auditoria/{eventoId} {
      allow read: if esAdmin() || esDirectivo() || (esDocente() && resource.data.usuarioId == request.auth.uid);
      allow create: if esStaff();
      allow update, delete: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
